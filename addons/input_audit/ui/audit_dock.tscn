[gd_scene load_steps=2 format=3 uid="uid://binputaudit00dk"]

[ext_resource type="Script" path="res://addons/input_audit/ui/audit_dock.gd" id="1_dock"]

[node name="Input Audit" type="VBoxContainer"]
custom_minimum_size = Vector2(240, 0)
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 4
script = ExtResource("1_dock")

[node name="Undefined" type="CheckBox" parent="."]
layout_mode = 2
button_pressed = true
tooltip_text = "Report action names used in code or scenes that the input map does not have."
text = "Names that do not exist"

[node name="Unbound" type="CheckBox" parent="."]
layout_mode = 2
button_pressed = true
tooltip_text = "Report actions with nothing bound, and actions only a mouse or touch can trigger."
text = "Nothing bound"

[node name="Devices" type="CheckBox" parent="."]
layout_mode = 2
button_pressed = true
tooltip_text = "Report actions a gamepad cannot trigger, and actions a keyboard cannot. Turn this off on a project that has decided it is one or the other."
text = "Keyboard and gamepad cover"

[node name="Duplicates" type="CheckBox" parent="."]
layout_mode = 2
button_pressed = true
tooltip_text = "Report one physical binding shared by two different actions."
text = "Shared bindings"

[node name="Deadzone" type="CheckBox" parent="."]
layout_mode = 2
button_pressed = true
tooltip_text = "Report gamepad-axis actions whose deadzone makes the stick unusable."
text = "Deadzones"

[node name="Unused" type="CheckBox" parent="."]
layout_mode = 2
button_pressed = true
tooltip_text = "Report actions in the input map that nothing in the project ever names."
text = "Actions nothing uses"

[node name="Sep" type="HSeparator" parent="."]
layout_mode = 2

[node name="CheckAll" type="Button" parent="."]
layout_mode = 2
tooltip_text = "Read the input map from the project file and every place the project names an action."
text = "Check the project"

[node name="Sep2" type="HSeparator" parent="."]
layout_mode = 2

[node name="ExportRow" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="SaveMd" type="Button" parent="ExportRow"]
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Write the last report to res://input_audit_report.md"
text = "Save .md"

[node name="SaveJson" type="Button" parent="ExportRow"]
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Write the last report to res://input_audit_report.json for a build server."
text = "Save .json"

[node name="Sep3" type="HSeparator" parent="."]
layout_mode = 2

[node name="Log" type="RichTextLabel" parent="."]
custom_minimum_size = Vector2(0, 180)
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
scroll_following = true
selection_enabled = true
